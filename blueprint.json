{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "preferredVersions": {
    "php": "8.2",
    "wp": "beta"
  },
  "features": {
    "networking": true
  },
  "login": true,
  "landingPage": "/wp-admin/plugins.php",
  "steps": [
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "ai"
      }
    },
    {
      "step": "activatePlugin",
      "pluginPath": "ai/ai.php"
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "url",
        "url": "https://github.com/wptrainingteam/wcpt-2026-ai-workshop/archive/refs/heads/trunk.zip"
      }
    },
    {
      "step": "activatePlugin",
      "pluginPath": "wcpt-2026-ai-workshop-trunk/plugin.php"
    },
    {
      "step": "activateTheme",
      "themeFolderName": "twentytwentyfive"
    },
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "WC Portugal 2026 Workshop"
      }
    }
  ]
}
